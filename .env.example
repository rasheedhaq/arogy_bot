# =============================================
# AROGYAMITRA BOT - ENVIRONMENT CONFIGURATION
# ARM_MVP0 (Zero Cost Version)
# =============================================
# 
# SETUP INSTRUCTIONS:
# 1. Copy this file to .env
# 2. Fill in your actual API keys
# 3. Never commit the .env file to git
#

# =====================
# Telegram Bot Configuration
# =====================
# Get token from: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# =====================
# Groq API Configuration (FREE)
# =====================
# Get free key from: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# =====================
# Google Gemini Configuration (OPTIONAL)
# =====================
# Get free key from: https://aistudio.google.com/apikey
# NOTE: Currently disabled due to Python 3.13 compatibility
GEMINI_API_KEY=your_gemini_api_key_here
USE_GEMINI=false
GEMINI_MODEL=gemini-1.5-flash

# =====================
# WhatsApp Configuration (FUTURE)
# =====================
WHATSAPP_VERIFY_TOKEN=verify-me
WHATSAPP_TOKEN=

# =====================
# Application Settings
# =====================
BASE_URL=http://localhost:8000
DEBUG=true

# Doctor Database Path
DOCTORS_DB_PATH=data/doctors_enhanced.csv

ENVIRONMENT=development
