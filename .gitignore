# =====================
# SENSITIVE FILES - NEVER COMMIT
# =====================
.env
!.env.example
config.local.yml

# API Keys and Secrets
*_key.txt
*_token.txt
secrets/

# =====================
# DATA FILES - PRIVATE
# =====================
data/*.csv
data/*.json
data/*.xlsx
!data/doctors_sample.csv
!data/doctors_enhanced.csv

# Exclude old doctor data
data/doctors_clean.csv
data/doctors.csv

# Documentation (allow tracking docs in the repo)
# The top-level rule may have previously excluded docs/ entirely; allow docs/ and all files beneath it.
!docs/
!docs/**

# =====================
# PYTHON
# =====================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
ENV/
env/
arogyamitra_env/

# =====================
# IDE
# =====================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

